# Copier vers .env pour le développement local.
# Dans l'add-on Home Assistant, ces variables sont définies par run.sh.

DATABASE_URL="file:./dev.db"

# Générer avec:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum"

# Fuseau utilisé pour décider ce qu'est « aujourd'hui » et « cette semaine ».
APP_TIMEZONE="America/Toronto"

# Facultatifs: NIP imposés, qui font foi sur ceux choisis dans l'app (4 à 8
# chiffres, NIP parent différent du NIP d'entrée). Dans l'add-on, ils viennent
# des options access_pin et parent_pin.
# ACCESS_PIN="1234"
# PARENT_PIN="9999"
