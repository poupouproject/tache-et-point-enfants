# Les motifs sont volontairement sans « / » initial: l'application vit dans le
# sous-dossier taches-et-points/, donc ils doivent matcher à n'importe quelle
# profondeur.

# dépendances
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# tests
coverage/

# next.js
.next/
out/
next-env.d.ts

# production
build/

# divers
.DS_Store
*.pem

# journaux
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# variables d'environnement (l'exemple, lui, est versionné)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# client Prisma généré (recréé par `prisma generate`)
**/src/generated/

# bases SQLite locales
*.db
*.db-journal
